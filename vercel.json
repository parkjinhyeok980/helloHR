{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd FE && npm ci",
  "buildCommand": "cd FE && npm run build",
  "outputDirectory": "FE/dist",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api?__django_path=$1" },
    { "handle": "filesystem" }
  ]
}
